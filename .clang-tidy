# Factory-owned file: agents must not edit it. The curated clang-tidy checks of the lint gate; every
# warning is an error. Excluded checks are style-only or fight the Catch2 macros:
# - easily-swappable-parameters, magic-numbers, identifier-length, trailing return types: style only;
# - function-cognitive-complexity, chained-comparison, cert-err58-cpp: raised by every TEST_CASE/CHECK;
# - avoid-do-while, avoid-non-const-global-variables, optin.core.EnumCastOutOfRange: the Catch2 macros
#   themselves;
# - avoid-pragma-once: every supported compiler has #pragma once, and it cannot clash like a guard name.
Checks: >-
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-chained-comparison,
  -cert-err58-cpp,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src|tests)/.*'
FormatStyle: none
