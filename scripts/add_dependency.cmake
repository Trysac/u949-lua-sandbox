# Adds a vcpkg dependency: `cmake -P scripts/add_dependency.cmake -- [--test] <port> [<spec>]`.
#
# <spec> is empty, an exact version (`1.2.3` or `==1.2.3`) or a range (`>=1.2` or `>=1.2,<2`). The latest version
# of the port in the vcpkg registry (at vcpkg.json's builtin-baseline) that satisfies it is written exactly: a
# `version>=` constraint plus an override. `--test` puts the port in the "tests" feature, linked only by the tests.
# Then vcpkg installs it, and the find_package call and targets of the port's usage notes are written to
# cmake/dependencies.cmake, so the library (or the tests) link it without a build change. A failed install or
# configure restores both files. Factory-owned file: agents must not edit it.
include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")

function(fail)
  string(JOIN "" text ${ARGN})
  message(NOTICE "add_dependency: ${text}")
  cmake_language(EXIT 1)
endfunction()

# --- arguments --------------------------------------------------------------------------------------------------

set(args)
set(after_separator FALSE)
math(EXPR last_arg "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last_arg})
  if(after_separator)
    list(APPEND args "${CMAKE_ARGV${i}}")
  elseif("${CMAKE_ARGV${i}}" STREQUAL "--")
    set(after_separator TRUE)
  endif()
endforeach()
set(test_scope FALSE)
if(args AND "${args}" MATCHES "(^|;)--git(;|$)")
  fail("factory repositories are not installable in C++ yet (they are not in a vcpkg registry)")
endif()
if(NOT args)
  fail("usage: cmake -P scripts/add_dependency.cmake -- [--test] <port> [<spec>]")
endif()
list(GET args 0 first)
if(first STREQUAL "--test")
  set(test_scope TRUE)
  list(REMOVE_AT args 0)
endif()
list(LENGTH args count)
if(count LESS 1 OR count GREATER 2)
  fail("usage: cmake -P scripts/add_dependency.cmake -- [--test] <port> [<spec>]")
endif()
list(GET args 0 port)
set(spec "")
if(count EQUAL 2)
  list(GET args 1 spec)
endif()
if(NOT port MATCHES "^[a-z0-9]+(-[a-z0-9]+)*$")
  fail("\"${port}\" is not a vcpkg port name (lower-case letters, digits and dashes)")
endif()
string(REPLACE " " "" spec "${spec}")
set(minimum "")
set(below "")
set(exact "")
if(spec MATCHES "^(==)?([0-9][0-9A-Za-z.-]*)$")
  set(exact "${CMAKE_MATCH_2}")
elseif(spec MATCHES "^>=([0-9][0-9A-Za-z.-]*)(,<([0-9][0-9A-Za-z.-]*))?$")
  set(minimum "${CMAKE_MATCH_1}")
  set(below "${CMAKE_MATCH_3}")
elseif(NOT spec STREQUAL "")
  fail("unsupported version spec \"${spec}\": use empty, x.y.z, ==x.y.z, >=x.y or >=x.y,<z")
endif()

# --- the version, from the registry's version database ----------------------------------------------------------

if(NOT DEFINED ENV{VCPKG_ROOT})
  fail("VCPKG_ROOT is not set")
endif()
string(SUBSTRING "${port}" 0 1 letter)
set(database "$ENV{VCPKG_ROOT}/versions/${letter}-/${port}.json")
if(NOT EXISTS "${database}")
  fail("no vcpkg port named \"${port}\" in ${database}")
endif()
file(READ "${database}" versions_json)
string(JSON entries LENGTH "${versions_json}" versions)
set(chosen "")
set(chosen_port_version 0)
math(EXPR last "${entries} - 1")
foreach(i RANGE ${last})
  string(JSON entry GET "${versions_json}" versions ${i})
  set(version "")
  foreach(key version version-semver version-date version-string)
    string(JSON value ERROR_VARIABLE missing GET "${entry}" "${key}")
    if(NOT missing)
      set(version "${value}")
      break()
    endif()
  endforeach()
  string(JSON port_version ERROR_VARIABLE missing GET "${entry}" port-version)
  if(missing)
    set(port_version 0)
  endif()
  if(version STREQUAL "" OR version MATCHES "(alpha|beta|rc|pre|dev)")
    continue()
  endif()
  if(NOT exact STREQUAL "" AND NOT version STREQUAL exact)
    continue()
  endif()
  if(NOT minimum STREQUAL "" AND version VERSION_LESS minimum)
    continue()
  endif()
  if(NOT below STREQUAL "" AND NOT version VERSION_LESS below)
    continue()
  endif()
  if(chosen STREQUAL "" OR version VERSION_GREATER chosen
     OR (version VERSION_EQUAL chosen AND port_version GREATER chosen_port_version))
    set(chosen "${version}")
    set(chosen_port_version "${port_version}")
  endif()
endforeach()
if(chosen STREQUAL "")
  fail("no version of ${port} in the vcpkg registry satisfies \"${spec}\"")
endif()
set(pinned "${chosen}")
if(chosen_port_version GREATER 0)
  set(pinned "${chosen}#${chosen_port_version}")
endif()

# --- vcpkg.json -------------------------------------------------------------------------------------------------

set(manifest_path "${FABRICA_ROOT}/vcpkg.json")
set(wiring_path "${FABRICA_ROOT}/cmake/dependencies.cmake")
file(READ "${manifest_path}" manifest_before)
file(READ "${wiring_path}" wiring_before)
set(manifest "${manifest_before}")

# Removes `port` from the dependency array at the JSON path in ARGN (if the array exists).
function(drop_dependency out json)
  string(JSON n ERROR_VARIABLE missing LENGTH "${json}" ${ARGN})
  if(missing OR n EQUAL 0)
    set(${out} "${json}" PARENT_SCOPE)
    return()
  endif()
  math(EXPR i "${n} - 1")
  while(i GREATER_EQUAL 0)
    string(JSON kind TYPE "${json}" ${ARGN} ${i})
    if(kind STREQUAL "STRING")
      string(JSON name GET "${json}" ${ARGN} ${i})
    else()
      string(JSON name GET "${json}" ${ARGN} ${i} name)
    endif()
    if(name STREQUAL port)
      string(JSON json REMOVE "${json}" ${ARGN} ${i})
    endif()
    math(EXPR i "${i} - 1")
  endwhile()
  set(${out} "${json}" PARENT_SCOPE)
endfunction()

drop_dependency(manifest "${manifest}" dependencies)
drop_dependency(manifest "${manifest}" features tests dependencies)
drop_dependency(manifest "${manifest}" overrides)
if(test_scope)
  set(path features tests dependencies)
  string(JSON has_feature ERROR_VARIABLE missing GET "${manifest}" features tests)
  if(missing)
    string(JSON manifest SET "${manifest}" features tests
           "{\"description\": \"Test-only dependencies\", \"dependencies\": []}")
  endif()
else()
  set(path dependencies)
  string(JSON has_dependencies ERROR_VARIABLE missing GET "${manifest}" dependencies)
  if(missing)
    string(JSON manifest SET "${manifest}" dependencies "[]")
  endif()
endif()
string(JSON n LENGTH "${manifest}" ${path})
string(JSON manifest SET "${manifest}" ${path} ${n} "{\"name\": \"${port}\", \"version>=\": \"${pinned}\"}")
string(JSON has_overrides ERROR_VARIABLE missing GET "${manifest}" overrides)
if(missing)
  string(JSON manifest SET "${manifest}" overrides "[]")
endif()
string(JSON n LENGTH "${manifest}" overrides)
if(chosen_port_version GREATER 0)
  set(override "{\"name\": \"${port}\", \"version\": \"${chosen}\", \"port-version\": ${chosen_port_version}}")
else()
  set(override "{\"name\": \"${port}\", \"version\": \"${chosen}\"}")
endif()
string(JSON manifest SET "${manifest}" overrides ${n} "${override}")
file(WRITE "${manifest_path}" "${manifest}\n")

# --- install, then wire the port's CMake targets ----------------------------------------------------------------

function(restore_and_fail)
  file(WRITE "${manifest_path}" "${manifest_before}")
  file(WRITE "${wiring_path}" "${wiring_before}")
  fail(${ARGN})
endfunction()

fabrica_configure(code console)
if(NOT code EQUAL 0)
  restore_and_fail("vcpkg could not install ${port} ${pinned} (${code}); vcpkg.json is unchanged")
endif()
# The port's own usage notes, else the ones vcpkg derives from the installed CMake config files and prints.
file(GLOB usage_files "${FABRICA_BUILD}/vcpkg_installed/*/share/${port}/usage")
set(usage "")
if(usage_files)
  list(GET usage_files 0 usage_file)
  file(READ "${usage_file}" usage)
else()
  string(FIND "${console}" "\n${port} provides CMake targets:" at)
  if(at GREATER -1)
    string(SUBSTRING "${console}" ${at} -1 usage)
    # Only this port's block: its title line and the blank or indented lines after it.
    string(REGEX MATCH "^\n[^\n]*\n(\n|[ \t][^\n]*\n)*" usage "${usage}")
  endif()
endif()
if(usage STREQUAL "")
  restore_and_fail("${port} has no CMake usage notes: wire its targets by hand (a human)")
endif()
if(NOT usage MATCHES "find_package\\(([^)]*)\\)")
  restore_and_fail("no find_package call in the usage notes of ${port}")
endif()
set(find_args "${CMAKE_MATCH_1}")
if(NOT usage MATCHES "target_link_libraries\\(main[ \t]+(PRIVATE|PUBLIC|INTERFACE)[ \t]+([^)]*)\\)")
  restore_and_fail("no target_link_libraries call in the usage notes of ${port}")
endif()
string(STRIP "${CMAKE_MATCH_2}" targets)
string(REGEX REPLACE "[ \t\r\n]+" " " targets "${targets}")
if(test_scope)
  set(scope tests)
  set(list_name FABRICA_TEST_TARGETS)
else()
  set(scope library)
  set(list_name FABRICA_LIBRARY_TARGETS)
endif()
# Drop an earlier block of this port, then append the new one.
string(REGEX REPLACE "\n# ${port} \\([a-z]+\\)\nfind_package\\([^)]*\\)\nlist\\(APPEND [A-Z_]+ [^)]*\\)\n" "\n" wiring
                     "${wiring_before}")
string(APPEND wiring "\n# ${port} (${scope})\nfind_package(${find_args})\nlist(APPEND ${list_name} ${targets})\n")
file(WRITE "${wiring_path}" "${wiring}")
fabrica_configure(code)
if(NOT code EQUAL 0)
  restore_and_fail("the build does not configure with ${port}'s targets (${code}); vcpkg.json is unchanged")
endif()
fabrica_say("add_dependency: ${port} ${pinned} (${scope}): find_package(${find_args}), ${targets}")
