# Runs every quality gate of this repository, in order, stopping at the first failure.
#
# Usage: `cmake -P scripts/check.cmake` (the same command locally, in the factory and in CI); append
# `-- <gate> ...` to run only those gates, in the standard order.
#
# Gates: clang-format, lint (the clang build with -Wall -Wextra -Wpedantic -Werror and clang-tidy with every
# warning as an error), semgrep (Semgrep CE with the factory's own rules in .semgrep/), tests (Catch2 under
# llvm-cov) with line coverage >= 80 % of the library, docs (the documentation manifest and Doxygen on the public
# headers, warnings as errors), secrets (gitleaks), audit (OSV over the upstream release of every vcpkg dependency,
# any vulnerability fails) and osv (OSV-Scanner over the repository, high severity). CMake script mode: no shell,
# the same on Windows and Linux. Factory-owned file: agents must not edit it.
include("${CMAKE_CURRENT_LIST_DIR}/sources.cmake")

set(MIN_COVERAGE 80)
set(DOCS_MANIFEST "docs-manifest.json")
set(ALLOW_MISSING_GITLEAKS "FABRICA_ALLOW_MISSING_GITLEAKS")
set(ALLOW_OFFLINE_AUDIT "FABRICA_ALLOW_OFFLINE_AUDIT")
# FABRICA_CI=1 also runs the test cases tagged [conformance] (external tools or downloads); only the CI conformance
# job sets it, so local gates and coverage skip them (CMakeLists.txt reads it at configure time).
set(CI_TIER "FABRICA_CI")
# The factory's own Semgrep rules; Semgrep-maintained rules are never used (license).
set(SEMGREP_RULES ".semgrep/factory-rules.yml")
set(HIGH_CVSS 7.0)
# osv-scanner's exit codes: 1 when vulnerabilities were found, 128 when no package was found.
set(OSV_FOUND 1)
set(OSV_NO_PACKAGES 128)
set(GATES format lint semgrep tests docs secrets audit osv)

# --- helpers ----------------------------------------------------------------------------------------------------
# Each gate is a function that sets `gate_failure` in the caller's scope to a message when it fails.

# A JSON value, or "" when it is missing.
function(json_or_empty out json)
  string(JSON value ERROR_VARIABLE err GET "${json}" ${ARGN})
  if(err)
    set(value "")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The length of a JSON array or object, or 0 when it is missing.
function(json_length out json)
  string(JSON value ERROR_VARIABLE err LENGTH "${json}" ${ARGN})
  if(err)
    set(value 0)
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# --- gates ------------------------------------------------------------------------------------------------------

function(format_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_cpp_sources(files)
  if(NOT files)
    set(gate_failure "no C++ files under include/, src/ or tests/" PARENT_SCOPE)
    return()
  endif()
  fabrica_run(code clang-format --dry-run -Werror ${files})
  if(NOT code EQUAL 0)
    set(gate_failure "clang-format found unformatted files (${code}): run `cmake -P scripts/format.cmake`"
        PARENT_SCOPE)
    return()
  endif()
  list(LENGTH files count)
  fabrica_say("clang-format: ${count} files formatted")
endfunction()

# The clang build of the library and the tests (the CI-only conformance tier included, so it compiles here first)
# with warnings as errors and clang-tidy on every file.
function(lint_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_configure(code)
  if(NOT code EQUAL 0)
    set(gate_failure "configure failed (${code})" PARENT_SCOPE)
    return()
  endif()
  fabrica_run(code "${CMAKE_COMMAND}" --build "${FABRICA_BUILD}" --parallel ${FABRICA_JOBS})
  if(NOT code EQUAL 0)
    set(gate_failure "the build failed (${code}): compiler warnings and clang-tidy findings are errors"
        PARENT_SCOPE)
  endif()
endfunction()

function(semgrep_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_which(exe semgrep)
  if(NOT exe)
    fabrica_flag(ci ${CI_TIER})
    if(ci)
      set(gate_failure "semgrep not installed (required when ${CI_TIER}=1)" PARENT_SCOPE)
    else()
      fabrica_say("semgrep: skipped: semgrep not installed")
    endif()
    return()
  endif()
  # ERROR rules fail and `nosemgrep` comments are ignored; tests and scripts/ are not scanned.
  fabrica_run(code "${exe}" scan --config "${SEMGREP_RULES}" --error --severity ERROR --metrics off
              --disable-version-check --disable-nosem --quiet --exclude=scripts --exclude=tests .)
  if(NOT code EQUAL 0)
    set(gate_failure "semgrep reported findings (${code})" PARENT_SCOPE)
  endif()
endfunction()

# The line coverage of the library (include/ and src/) in a `llvm-cov export -summary-only` report.
function(line_coverage out report)
  json_or_empty(percent "${report}" data 0 totals lines percent)
  set(${out} "${percent}" PARENT_SCOPE)
endfunction()

function(tests_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_flag(ci ${CI_TIER})
  if(ci)
    fabrica_say("tests: CI tier, the [conformance] test cases run")
  endif()
  # Configure again: the conformance filter is read from FABRICA_CI at configure time.
  fabrica_configure(code)
  if(code EQUAL 0)
    fabrica_run(code "${CMAKE_COMMAND}" --build "${FABRICA_BUILD}" --parallel ${FABRICA_JOBS})
  endif()
  if(NOT code EQUAL 0)
    set(gate_failure "the build failed (${code})" PARENT_SCOPE)
    return()
  endif()
  set(raw "${FABRICA_BUILD}/coverage")
  file(REMOVE_RECURSE "${raw}")
  fabrica_run(code ctest --test-dir "${FABRICA_BUILD}" --output-on-failure)
  if(NOT code EQUAL 0)
    set(gate_failure "tests failed (${code})" PARENT_SCOPE)
    return()
  endif()
  file(GLOB profiles "${raw}/*.profraw")
  if(NOT profiles)
    set(gate_failure "no coverage data in ${raw}" PARENT_SCOPE)
    return()
  endif()
  set(merged "${FABRICA_BUILD}/coverage.profdata")
  fabrica_run(code llvm-profdata merge -sparse ${profiles} -o "${merged}")
  if(NOT code EQUAL 0)
    set(gate_failure "llvm-profdata failed (${code})" PARENT_SCOPE)
    return()
  endif()
  set(binary "${FABRICA_BUILD}/unit_tests${CMAKE_EXECUTABLE_SUFFIX}")
  if(NOT EXISTS "${binary}")
    set(binary "${FABRICA_BUILD}/unit_tests.exe")
  endif()
  execute_process(
    COMMAND llvm-cov export -summary-only "-instr-profile=${merged}" "${binary}" "${FABRICA_ROOT}/include"
            "${FABRICA_ROOT}/src"
    WORKING_DIRECTORY "${FABRICA_ROOT}" RESULT_VARIABLE code OUTPUT_VARIABLE report)
  if(NOT code EQUAL 0)
    set(gate_failure "llvm-cov failed (${code})" PARENT_SCOPE)
    return()
  endif()
  line_coverage(total "${report}")
  if(total STREQUAL "")
    set(gate_failure "no line total in the llvm-cov report" PARENT_SCOPE)
    return()
  endif()
  fabrica_say("Total coverage: ${total}%")
  if(total LESS MIN_COVERAGE)
    set(gate_failure "total line coverage ${total}% is below ${MIN_COVERAGE}%" PARENT_SCOPE)
    return()
  endif()
  fabrica_say("tests: line coverage ${total}% (minimum ${MIN_COVERAGE}%)")
endfunction()

# Every violation of docs-manifest.json, as a list of messages.
function(docs_errors out)
  set(errors)
  set(manifest_path "${FABRICA_ROOT}/${DOCS_MANIFEST}")
  if(NOT EXISTS "${manifest_path}")
    set(${out} "${DOCS_MANIFEST} not found" PARENT_SCOPE)
    return()
  endif()
  file(READ "${manifest_path}" manifest)
  string(JSON kind ERROR_VARIABLE err TYPE "${manifest}")
  if(err OR NOT kind STREQUAL "OBJECT")
    set(${out} "${DOCS_MANIFEST}: not a JSON object" PARENT_SCOPE)
    return()
  endif()
  json_length(count "${manifest}" required)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      json_or_empty(rel "${manifest}" required ${i})
      set(path "${FABRICA_ROOT}/${rel}")
      if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        list(APPEND errors "missing required file: ${rel}")
      else()
        file(READ "${path}" text)
        string(STRIP "${text}" text)
        if(text STREQUAL "")
          list(APPEND errors "required file is empty: ${rel}")
        endif()
      endif()
    endforeach()
  endif()
  json_length(count "${manifest}" required_globs)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      json_or_empty(pattern "${manifest}" required_globs ${i})
      file(GLOB matches LIST_DIRECTORIES false "${FABRICA_ROOT}/${pattern}")
      if(NOT matches)
        list(APPEND errors "no file matches required pattern: ${pattern}")
      endif()
    endforeach()
  endif()
  json_length(count "${manifest}" max_lines)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON rel MEMBER "${manifest}" max_lines ${i})
      json_or_empty(limit "${manifest}" max_lines "${rel}")
      if(EXISTS "${FABRICA_ROOT}/${rel}")
        file(READ "${FABRICA_ROOT}/${rel}" text)
        string(REPLACE "\r\n" "\n" text "${text}")
        string(REGEX REPLACE "\n+$" "" text "${text}")
        if(text STREQUAL "")
          set(lines 0)
        else()
          string(REGEX MATCHALL "\n" breaks "${text}")
          list(LENGTH breaks lines)
          math(EXPR lines "${lines} + 1")
        endif()
        if(lines GREATER limit)
          list(APPEND errors "${rel} has ${lines} lines (max ${limit})")
        endif()
      endif()
    endforeach()
  endif()
  json_length(count "${manifest}" must_reference)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON rel MEMBER "${manifest}" must_reference ${i})
      json_or_empty(needle "${manifest}" must_reference "${rel}")
      if(EXISTS "${FABRICA_ROOT}/${rel}")
        file(READ "${FABRICA_ROOT}/${rel}" text)
        string(FIND "${text}" "${needle}" at)
        if(at EQUAL -1)
          list(APPEND errors "${rel} must reference ${needle}")
        endif()
      endif()
    endforeach()
  endif()
  set(${out} "${errors}" PARENT_SCOPE)
endfunction()

function(docs_gate)
  set(gate_failure "" PARENT_SCOPE)
  docs_errors(errors)
  if(errors)
    foreach(err IN LISTS errors)
      message(NOTICE "docs: ${err}")
    endforeach()
    list(LENGTH errors count)
    set(gate_failure "${count} documentation problem(s)" PARENT_SCOPE)
    return()
  endif()
  fabrica_say("docs: every file in docs-manifest.json is present")
  # Doxygen documents nothing here: it reports every undocumented public declaration, and any warning fails.
  fabrica_which(doxygen doxygen)
  if(NOT doxygen)
    set(gate_failure "doxygen is not installed (https://www.doxygen.nl/download.html)" PARENT_SCOPE)
    return()
  endif()
  set(ENV{FABRICA_DOXYGEN_DIR} "${FABRICA_BUILD}/doxygen")
  file(MAKE_DIRECTORY "$ENV{FABRICA_DOXYGEN_DIR}")
  fabrica_run(code "${doxygen}" Doxyfile)
  if(NOT code EQUAL 0)
    set(gate_failure "Doxygen warnings on the public headers (${code}): document every public declaration"
        PARENT_SCOPE)
    return()
  endif()
  fabrica_say("docs: Doxygen found every public declaration documented")
endfunction()

function(secrets_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_which(exe gitleaks)
  if(NOT exe)
    fabrica_flag(allow ${ALLOW_MISSING_GITLEAKS})
    if(allow)
      fabrica_say("gitleaks: SKIPPED (not installed)")
      return()
    endif()
    set(gate_failure "FAIL - gitleaks is not installed. Install it (https://github.com/gitleaks/gitleaks#installing),"
                     " e.g. `winget install Gitleaks.Gitleaks`, `brew install gitleaks` or a release binary,"
                     " or set ${ALLOW_MISSING_GITLEAKS}=1 to skip this gate locally.")
    string(JOIN "" gate_failure ${gate_failure})
    set(gate_failure "${gate_failure}" PARENT_SCOPE)
    return()
  endif()
  fabrica_run(code "${exe}" dir . --redact --verbose --no-banner)
  if(NOT code EQUAL 0)
    set(gate_failure "gitleaks found secrets (${code})" PARENT_SCOPE)
  endif()
endfunction()

# --- dependency gates -------------------------------------------------------------------------------------------
# vcpkg is not an OSV ecosystem, and neither is Conan. What OSV does know is the upstream git repositories of most
# C and C++ libraries (ecosystem GIT, from the CVE records). vcpkg writes an SPDX file for every installed port whose
# resources name the upstream source it built (`git+https://github.com/<owner>/<repo>@<tag>`), so:
# - audit: OSV over the upstream git tag (or commit) of every installed port; any known vulnerability fails. A port
#   built from a plain download (no git tag) is listed as not covered.
# - osv: OSV-Scanner over the repository itself (lockfiles and SBOMs a repository may hold, recursively); high or
#   unknown severity fails. A C++ repository usually holds none: that is reported, not a failure.

# The installed ports' upstream sources: sets `out` to a list of "port|https://host/owner/repo|ref" and `uncovered`
# to the ports with a source OSV cannot match.
function(upstream_sources out uncovered)
  set(found)
  set(missing)
  file(GLOB spdx_files "${FABRICA_BUILD}/vcpkg_installed/*/share/*/vcpkg.spdx.json")
  foreach(spdx_file IN LISTS spdx_files)
    get_filename_component(dir "${spdx_file}" DIRECTORY)
    get_filename_component(port "${dir}" NAME)
    file(READ "${spdx_file}" spdx)
    string(JSON count ERROR_VARIABLE err LENGTH "${spdx}" packages)
    if(err OR count EQUAL 0)
      continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON id ERROR_VARIABLE err GET "${spdx}" packages ${i} SPDXID)
      if(err OR NOT id MATCHES "^SPDXRef-resource-")
        continue()
      endif()
      string(JSON location ERROR_VARIABLE err GET "${spdx}" packages ${i} downloadLocation)
      if(NOT err AND location MATCHES "\\.(patch|diff)(\\?|$)")
        continue()  # a patch vcpkg applies on top of the source, not a source
      endif()
      if(NOT err AND location MATCHES "^git\\+(https://[^@]+)@([^@]+)$")
        set(repo "${CMAKE_MATCH_1}")
        set(ref "${CMAKE_MATCH_2}")
        string(REGEX REPLACE "\\.git$" "" repo "${repo}")
        list(APPEND found "${port}|${repo}|${ref}")
      else()
        list(APPEND missing "${port} (${location})")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES found)
  set(${out} "${found}" PARENT_SCOPE)
  set(${uncovered} "${missing}" PARENT_SCOPE)
endfunction()

function(audit_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_which(exe osv-scanner)
  if(NOT exe)
    fabrica_flag(allow FABRICA_ALLOW_OFFLINE_AUDIT)
    if(allow)
      fabrica_say("audit: SKIPPED (osv-scanner not installed)")
      return()
    endif()
    set(gate_failure "osv-scanner is not installed (go install github.com/google/osv-scanner/v2/cmd/osv-scanner@v2.6.0), or set FABRICA_ALLOW_OFFLINE_AUDIT=1 to skip this gate locally"
        PARENT_SCOPE)
    return()
  endif()
  fabrica_configure(code)
  if(NOT code EQUAL 0)
    set(gate_failure "configure failed (${code})" PARENT_SCOPE)
    return()
  endif()
  upstream_sources(sources uncovered)
  foreach(item IN LISTS uncovered)
    fabrica_say("audit: not covered by OSV (no upstream git tag): ${item}")
  endforeach()
  if(NOT sources)
    fabrica_say("audit: no vcpkg dependency with an upstream git source")
    return()
  endif()
  # osv-scanner's own result format, read back as a lockfile (`--lockfile=osv-scanner:<path>`).
  set(packages "")
  set(shown)
  foreach(item IN LISTS sources)
    string(REPLACE "|" ";" parts "${item}")
    list(GET parts 0 port)
    list(GET parts 1 repo)
    list(GET parts 2 ref)
    if(ref MATCHES "^[0-9a-f]{40}$")
      set(entry "{\"package\": {\"name\": \"${repo}\", \"ecosystem\": \"GIT\", \"commit\": \"${ref}\"}}")
    else()
      set(entry "{\"package\": {\"name\": \"${repo}\", \"ecosystem\": \"GIT\", \"version\": \"${ref}\"}}")
    endif()
    if(packages STREQUAL "")
      set(packages "${entry}")
    else()
      string(APPEND packages ", ${entry}")
    endif()
    list(APPEND shown "${port}: ${repo}@${ref}")
  endforeach()
  set(list_file "${FABRICA_BUILD}/osv-dependencies.json")
  file(WRITE "${list_file}" "{\"results\": [{\"source\": {\"path\": \"${list_file}\", \"type\": \"lockfile\"}, \"packages\": [${packages}]}]}\n")
  foreach(line IN LISTS shown)
    fabrica_say("audit: ${line}")
  endforeach()
  fabrica_run(code "${exe}" scan source "--lockfile=osv-scanner:${list_file}")
  if(code EQUAL 1)
    set(gate_failure "known vulnerabilities in the vcpkg dependencies" PARENT_SCOPE)
    return()
  endif()
  if(NOT code EQUAL 0)
    set(gate_failure "osv-scanner failed (exit ${code})" PARENT_SCOPE)
    return()
  endif()
  list(LENGTH sources count)
  fabrica_say("audit: no known vulnerabilities in ${count} upstream sources")
endfunction()

# The advisory groups of an osv-scanner JSON report with CVSS >= 7.0 or no score (unknown counts as high).
function(osv_blocking out report)
  set(blocking)
  string(JSON results ERROR_VARIABLE err LENGTH "${report}" results)
  if(err OR results EQUAL 0)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  math(EXPR last_result "${results} - 1")
  foreach(r RANGE ${last_result})
    string(JSON packages ERROR_VARIABLE err LENGTH "${report}" results ${r} packages)
    if(err OR packages EQUAL 0)
      continue()
    endif()
    math(EXPR last_package "${packages} - 1")
    foreach(p RANGE ${last_package})
      string(JSON name ERROR_VARIABLE err GET "${report}" results ${r} packages ${p} package name)
      string(JSON version ERROR_VARIABLE err GET "${report}" results ${r} packages ${p} package version)
      string(JSON groups ERROR_VARIABLE err LENGTH "${report}" results ${r} packages ${p} groups)
      if(err OR groups EQUAL 0)
        continue()
      endif()
      math(EXPR last_group "${groups} - 1")
      foreach(g RANGE ${last_group})
        string(JSON severity ERROR_VARIABLE err GET "${report}" results ${r} packages ${p} groups ${g} max_severity)
        if(err)
          set(severity "")
        endif()
        string(STRIP "${severity}" severity)
        string(JSON ids ERROR_VARIABLE err GET "${report}" results ${r} packages ${p} groups ${g} ids 0)
        if(severity STREQUAL "" OR NOT severity MATCHES "^[0-9.]+$")
          list(APPEND blocking "${name}@${version} ${ids} (unknown)")
        elseif(NOT severity LESS 7.0)
          list(APPEND blocking "${name}@${version} ${ids} (${severity})")
        endif()
      endforeach()
    endforeach()
  endforeach()
  set(${out} "${blocking}" PARENT_SCOPE)
endfunction()

function(osv_gate)
  set(gate_failure "" PARENT_SCOPE)
  fabrica_which(exe osv-scanner)
  if(NOT exe)
    fabrica_flag(ci FABRICA_CI)
    if(ci)
      set(gate_failure "osv-scanner not installed (required when FABRICA_CI=1)" PARENT_SCOPE)
    else()
      fabrica_say("osv-scanner: skipped: osv-scanner not installed")
    endif()
    return()
  endif()
  execute_process(COMMAND "${exe}" scan source --format json --recursive .
                  WORKING_DIRECTORY "${FABRICA_ROOT}" RESULT_VARIABLE code OUTPUT_VARIABLE report)
  if(code EQUAL 128)
    fabrica_say("osv-scanner: no lockfile or SBOM in the repository (the vcpkg dependencies are the audit gate's)")
    return()
  endif()
  if(code EQUAL 0)
    fabrica_say("osv-scanner: no known vulnerabilities in the repository's lockfiles")
    return()
  endif()
  if(NOT code EQUAL 1)
    set(gate_failure "osv-scanner failed (${code})" PARENT_SCOPE)
    return()
  endif()
  osv_blocking(blocking "${report}")
  foreach(line IN LISTS blocking)
    message(NOTICE "osv-scanner: ${line}")
  endforeach()
  if(blocking)
    list(LENGTH blocking count)
    set(gate_failure "${count} advisory group(s) of high or unknown severity" PARENT_SCOPE)
    return()
  endif()
  fabrica_say("osv-scanner: only advisories below high severity (reported, not failing)")
endfunction()

# --- main -------------------------------------------------------------------------------------------------------

set(only)
set(after_separator FALSE)
math(EXPR last_arg "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last_arg})
  set(arg "${CMAKE_ARGV${i}}")
  if(after_separator)
    list(APPEND only "${arg}")
  elseif(arg STREQUAL "--")
    set(after_separator TRUE)
  endif()
endforeach()
foreach(name IN LISTS only)
  if(NOT name IN_LIST GATES)
    message(NOTICE "check: unknown gate \"${name}\"")
    cmake_language(EXIT 2)
  endif()
endforeach()
foreach(name IN LISTS GATES)
  if(only AND NOT name IN_LIST only)
    continue()
  endif()
  fabrica_say("==> ${name}")
  set(gate_failure "")
  cmake_language(CALL ${name}_gate)
  if(NOT gate_failure STREQUAL "")
    message(NOTICE "${name}: ${gate_failure}")
    message(NOTICE "==> ${name}: FAILED")
    cmake_language(EXIT 1)
  endif()
  fabrica_say("==> ${name}: ok")
endforeach()
fabrica_say("==> all gates passed")
