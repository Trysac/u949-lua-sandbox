# Factory-owned file: agents must not edit it. The docs gate runs Doxygen on the public headers only
# to enforce their documentation: an undocumented declaration, parameter or return value is a
# warning, and any warning fails. Only XML is generated (Doxygen needs one output format), into the
# build directory.
PROJECT_NAME           = "lua-sandbox"
INPUT                  = include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_ANON_NSPACES   = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
OUTPUT_DIRECTORY       = $(FABRICA_DOXYGEN_DIR)
